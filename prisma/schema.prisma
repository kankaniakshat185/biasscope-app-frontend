// This schema intentionally covers ONLY the Better Auth tables. This app
// never queries Search/Article/Insight/Claim/etc. directly — all of that
// data is read through the backend's HTTP API — but this file used to
// carry a second, stale copy of those models anyway (missing columns the
// backend had already added, like sourceBias/driftMetrics/entitySentiment)
// pointed at the SAME physical database as biasscope-hf-backend's schema.
// That's the "two owners for one schema" drift described in AUDIT_TASKS.md
// A5: two independent migration histories fighting over shared tables.
//
// The backend's prisma/schema.prisma is the single source of truth for
// Search/Article/Insight and everything else. If this app ever needs to
// query one of those tables directly, add a `@@ignore`-annotated read-only
// model here rather than a second authoritative copy.
//
// IMPORTANT: only ever run `prisma generate` against this schema (that's
// all `npm run build` does, and it's pure code-gen — no DB connection).
// Do NOT run `prisma migrate dev` or `prisma db push` from this repo: since
// this schema no longer declares Search/Article/Insight, either command
// would try to DROP those tables out from under the backend that still
// owns and uses them.

generator client_js {
  provider = "prisma-client-js"
  output   = "../frontend/node_modules/.prisma/client"
}

generator client_python {
  provider             = "prisma-client-js"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Better Auth Core Tables
// -------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// Search/Article/Insight (and the rest of the claim-intelligence graph)
// intentionally live only in biasscope-hf-backend/prisma/schema.prisma —
// see the note at the top of this file.
